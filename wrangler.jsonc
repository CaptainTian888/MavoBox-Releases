{
  "name": "mavobox-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "mavobox-site", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }],
  "vars": { "RELEASES_REPO": "CaptainTian888/MavoBox-Releases", "TIMEZONE_OFFSET_MINUTES": "480" }
}
